# LEGAL EASE — Environment Configuration Example

# Backend Settings
ENVIRONMENT=development
PORT=8000
DEBUG=True
API_V1_PREFIX=/api

# Database
# For quick local zero-config execution SQLite works out-of-the-box:
DATABASE_URL=sqlite:///./legalease.db
# For PostgreSQL in Docker or production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalease

# Authentication / Security
JWT_SECRET=super-secret-jwt-key-change-this-in-production-legal-ease-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Set MOCK_AI=true to test without Gemini API key
MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Uploads
UPLOAD_MAX_SIZE_MB=15
UPLOAD_DIR=./uploads

# Next.js Frontend (Used in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
